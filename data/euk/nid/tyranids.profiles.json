  "specialRules": [
    {
      "name": "Synapse",
      "description": "Formations with Synapse units can capture objectives; formations without them can only contest. Synapse formations do not receive blast markers for killed Gargoyles, Hormagaunts, or Termagants, and do not count those units lost in an assault when determining the winner."
    },
    {
      "name": "The Hunger",
      "description": "Tyranid formations receive +1 when attempting an Engage action or rolling to rally in the end phase."
    },
    {
      "name": "Fast and Slithering",
      "description": "Tyranid war engines, armoured vehicles, and light vehicles automatically pass difficult-terrain tests. Buildings are difficult terrain for these units rather than impassable; terrain tests still apply. Tyranid units are affected by minefields."
    }
  ]
