  "specialRules": [
    {
      "name": "The Hunger",
      "description": "All Tyranid formations receive +1 to Engage actions and rally rolls."
    },
    {
      "name": "Fast and Slithering",
      "description": "Tyranid war engines, armoured vehicles, and light vehicles automatically pass difficult-terrain tests; buildings count as difficult terrain for them. Tyranid units are affected by minefields."
    },
    {
      "name": "Synapse",
      "description": "Synapse formations can capture objectives. Formations without Synapse can only contest objectives. Synapse formations ignore blast markers and assault-loss counting for killed Gargoyles, Hormagaunts, and Termagants."
    },
    {
      "name": "Formation sizes",
      "description": "Big swarms double the number of core units. Limits on upgrades are doubled for big formations."
    }
  ]
