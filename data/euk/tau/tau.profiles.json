  "specialRules": [
    {
      "name": "Coordinated Fire",
      "description": "A unit with this ability can order up to two eligible formations within 15cm to follow its formation on an Advance, Double, or Sustained Fire action. Make one initiative roll, applying a single -1 modifier if any participating formation has blast markers. If failed, only the initiating formation receives a blast marker and takes Hold; other formations are unaffected. If passed, formations may choose different eligible actions, but must all fire at the same target. The ability is conferred to a formation joined by a unit with Coordinated Fire."
    },
    {
      "name": "Markerlights",
      "description": "Enemy formations within 30cm and line of fire of a Tau unit with Markerlights are marked. Tau ranged fire against marked formations receives +1 to hit, except anti-aircraft attacks. Guided Missiles may target a marked formation without line of fire. Broken formations and formations that marched cannot mark enemies."
    },
    {
      "name": "Tau Jet Packs",
      "description": "Follow Jump Pack rules. After an Advance, Double, or March action, units with Tau Jet Packs may make an additional 10cm move after firing. This move follows normal movement rules. Units without Tau Jet Packs do not receive this extra move."
    },
    {
      "name": "Tau Deflector Shields",
      "description": "Works like an Invulnerable Save, except the save is always 5+."
    },
    {
      "name": "Support Craft",
      "description": "Skimmers that count as popped up for line-of-sight and terrain purposes, do not block line of sight, and must use their Skimmer ability to force a firefight in engagements. Infantry in base contact cannot count as being in cover from a Support Craft. Transported units may take saves if the Support Craft is destroyed."
    },
    {
      "name": "Lance",
      "description": "Units with Reinforced Armour cannot re-roll failed armour saves against weapons with Lance."
    }
  ]
}
