  "specialRules": [
    {
      "name": "Brutkult",
      "description": [
        "Die Armee muss einen Brutkult-Verband enthalten. Der Gegner gilt als hätte er das Siegesziel „Brecht Ihren Willen“ (BTS) erreicht, wenn er diesen oder den teuersten Verband der Armee zerstört."
      ]
    },
    {
      "name": "Brutbewusstsein",
      "description": [
        "Alle Genestealer-Cult-Verbände mit einem Iconward, Magus, Primus, Patriarch oder Symbiontenlord erhalten einen Modifikator von +1 auf ihren Aktionstest, wenn sie eine Offensive durchführen, sowie einen Bonus von +1 auf Sammeltests."
      ]
    },
    {
      "name": "Brutbrüder",
      "description": [
        "Solange ein Verband einen Symbiontenpatriarch, Genestealer Primus, Symbiontenmagus oder Hybrid-Ikonwart enthält, verursachen Einheiten desselben Verbands mit der Sonderregel <i>Brutbrüder</i> weder bei ihrer Zerstörung noch bei einem Treffer durch eine Waffe mit der Sonderregel <i>Versprengen</i> Beschussmarken. Dies gilt auch für die zusätzliche Beschussmarke beim ersten Verlust durch Kreuzfeuer und für Einheiten, die nach einer Bewegung zerstört werden, weil sie sich ausserhalb der Verband befinden. Im Nahkampf getötete Einheiten mit <i>Brutbrüder</i> werden bei der Ermittlung des Ergebnisses mitgezählt."
      ]
    },
    {
      "name": "Extreme Beweglichkeit (Kult der Sternengeborenen)",
      "description": null
    }
  ],
