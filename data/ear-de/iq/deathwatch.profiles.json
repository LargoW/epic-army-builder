        "commit": null
    },
    "specialRules": [
        {
            "name": "Ad-hoc-Kontingente",
            "description": [
                "Das Ordo Xenos musste aus der Notwendigkeit heraus zum Experten für Improvisation werden, rasch lokale Verbündete sammeln und sich an die ständig wechselnden Fähigkeiten und Mitglieder der Deathwatch anpassen. Deshalb dürfen Verbände mit Befehlshaber die Fähigkeit auch einsetzen, wenn ihr eigener oder ein anderer befreundeter Verband innerhalb von 5cm gegen einen Angriff verteidigt; erkläre beide Verbände dabei als vermischt (siehe 1.12.10). Nach der Erklärung als vermischt folgen die Verbände des Commanders genau denselben Regeln, als hätte der Gegner sie als vermischt erklärt. Beachte: Erklärt ein Spieler die Verbände als vermischt, gelten sie als vermischt."
            ]
        },
        {
            "name": "Teleportieren-Peilsender",
            "description": [
                "Einheiten, die sich innerhalb von 15 cm zu einer befreundeten, nicht aufgeriebenen Einheit mit Teleportieren-Peilsender teleportieren (ausser teleportierende Verbände), dürfen beim Test auf eine Teleportieren-Fehlfunktion gewürfelte Einsen wiederholen.",
                "Zusätzlich dürfen Verbände, die ausschliesslich aus Modellen mit Teleportieren bestehen, in einem gekauften Raumschiff aufgestellt werden. Von dort können sie entweder normal teleportieren oder ihren Teleportieren mit der Aktivierung des Raumschiffs koordinieren.",
                "Mit der Aktivierung eines Raumschiffs koordinierte Teleportierens finden statt, nachdem das Orbitale Sperrfeuer, Punktziel-Angriffe und alle Ereignisse im Zusammenhang mit der Planetaren Landung von Verbänden abgehandelt wurden. Alle diese Teleportierens gelten als gleichzeitig und nicht nacheinander. Der gesamte Verband muss innerhalb von 15 cm zu einer Einheit mit der Sonderregel Teleportieren-Peilsender aufgestellt werden. Ist er dazu nicht in der Lage oder nicht bereit, muss er warten und in einer späteren Runde normal teleportieren."
            ]
        },
        {
            "name": "Schwingen des Himmelsengels",
            "description": [
                "Alle Deathwatch-Kontingente müssen das Spiel in Reserve beginnen und entweder in einem Dark-Hunter-Klasse-Zerstörer, einem Corvus-Blackstar-Landungsschiff oder einem Deathwatch-Thunderhawk-Transporter eingeschifft sein.",
                "Gegen Corvus-Blackstar-Landungsschiffe erleiden alle Flugabwehrschüsse zusätzlich einen Trefferwurfmodifikator von -1."
            ]
        }
    ],
