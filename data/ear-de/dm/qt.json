  "sections": [
    {
      "id": "core",
      "name": "Höllenschmiede-Kernformationen",
      "formations": [
        "dm-hollenschmiede-manipel"
      ]
    },
    {
      "id": "banner",
      "name": "Dämonische Bannerformationen",
      "rule": "Für jede Höllenschmiede-Kernformation dürfen bis zu drei dämonische Bannerformationen gewählt werden. Die Armee darf keine Verbände des Nurgle und Tzeentch oder des Slaanesh und Khorne miteinander kombinieren.",
      "formations": [
        "dm-hollenritter-des-slaanesh",
        "dm-hollengegseln-des-slaanesh",
        "dm-hollensitzer-des-slaanesh",
        "dm-schander-ritter-des-tzeentch",
        "dm-entweiher-ritter-des-nurgle",
        "dm-rampager-ritter-des-khorne",
        "dm-abtruenner-ritter-des-ungeteilten-chaos",
        "dm-tyrannenritter-des-ungeteilten-chaos",
        "dm-armiger-des-ungeteilten-chaos"
      ]
    },
    {
      "id": "support",
      "name": "Höllenschmiede-Unterstützung, Verräter-Titanen und Verbündete der Chaosflotte",
      "rule": "Bis zu ein Drittel der verfügbaren Punkte darf für diese Verbände ausgegeben werden.",
      "formations": [
        "dm-chrono-gladiatoren",
        "dm-ord-hereticus",
        "dm-ord-hereticus-majoris",
        "dm-Chaos Warbringer",
        "dm-hollendrachen",
        "dm-harbringer",
        "dm-chaos-schlachtschiff"
