    "commit": null
  },
  "specialRules": [
    {
      "name": "Flink zu Fuß",
      "description": [
        "Drukhari- und Harlekin-Verbände erhalten einen Bonus von +1, wenn sie versuchen, einen Marsch durchzuführen. Außerdem dürfen sie nach einem Marsch weiterhin Unterstützungsfeuer in Nahkämpfen leisten, einen Kreuzfeuerbonus beanspruchen und Flugabwehrfeuer abgeben."
      ]
    },
    {
      "name": "Schlag und Flucht",
      "description": [
        "Eldar-, Drukhari- und Harlekin-Verbände, die Vorrücken oder einen Eilschritt durchführen, dürfen vor oder nach jeder Bewegung Schießen, aber insgesamt weiterhin nur einmal. Entscheidet sich der Verband für einen Eilschritt, gilt der Trefferwurfmodifikator von -1 auch dann, wenn vor der Bewegung geschossen wird. außerdem dürfen Verbände, die einen Nahkampf gewinnen, sich bis zu ihrem Geschwindigkeitswert statt der üblichen 5cm neu formieren."
      ]
    },
    {
      "name": "Wraithkind-Gefolge",
      "description": [
        "Die Armee muss einen Wraithkind-Verband enthalten. Der Gegner gilt als hätte er das Siegesziel „Brecht Ihren Willen“ (BTS) erreicht, wenn er diesen Verband und/oder den teuersten Verband der Armee zerstört."
      ]
    },
    {
      "name": "Darf keine Garnison bilden (Wraithkind)",
      "description": [
        "Im Epic-Turnierszenario dürfen nur Mandraks Missionsziele als Garnison besetzen."
      ]
    },
    {
      "name": "Netzportal",
      "description": [
        "Eine Armee mit Netzportals darf bis zu drei Verbände in Reserve halten; Infanterieeinheiten dieser Reserveverbände dürfen als in ihren Transportern eingeschifft gelten. Diese Verbände können während des Spiels aktiviert werden und durch ein befreundetes Netzportal auf das Spielfeld ziehen. Ihre erste Bewegung wird von einem beliebigen Punkt innerhalb des vom Portal eingenommenen Bereichs aus gemessen.",
        "Ein Netzportal darf nur einmal pro Runde verwendet werden. Misslingt einem Verband die Aktivierung beim Versuch, durch ein Netzportal einzutreten, darf er nur eine Halten-Aktion ausserhalb des Spielfelds durchführen und sich sammeln. Nur INF, LV oder AV mit der Fähigkeit Geländegängig dürfen Netzportals verwenden. H-AV-Einheiten dürfen Portale nur verwenden, wenn ausdrücklich anders angegeben.",
        "Jedes Mal, wenn ein Verband ein zerstörtes Portal verwendet, erhält er eine Beschussmarke.",
        "Befindet sich ein Netzportal in einer gegnerischen Kontrollzone, muss jeder hindurchkommende Verband den gegnerischen Verband bzw. die gegnerischen Verbände offensiv angreifen. Befindet sich das Portal zudem direkt unter einem gegnerischen Verband, muss der eintretende Verband so viel Basekontakt wie möglich herstellen."
      ]
    },
    {
      "name": "Meister des Netzportals",
      "description": [
        "Harlekine sind die unvergleichlichen Meister des Webway. Sie müssen das Spiel in Reserve beginnen und dürfen das Schlachtfeld nur durch Teleportation oder ein Wraithgate betreten. Harlekine dürfen beim Test auf eine Teleportieren-Fehlfunktion gewürfelte Einsen wiederholen."
      ]
    },
    {
      "name": "Cegorach, der Lachende Gott",
      "description": [
        "Solange sich mindestens ein Solitär auf dem Schlachtfeld befindet, gelten alle gegnerischen Verbände ohne Harlekine bei Sammeltests in der Endphase als innerhalb von 30 cm zu einer gegnerischen Einheit."
      ]
    }
  ],
